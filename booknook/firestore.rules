rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public read-only catalog
    match /books/{bookId} {
      allow read: if true;
      allow write: if false; // restrict writes to admin tools only
    }

    // Users collection (profile metadata)
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId; // user can read their own profile
      allow write: if request.auth != null && request.auth.uid == userId; // user can update their profile
    }

    // Each authenticated user may read/write their own user_books document
    match /user_books/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Fallback: deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
